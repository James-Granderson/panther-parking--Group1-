diff --git a/app/services/lot_service.py b/app/services/lot_service.py
index 1275db4..68dd732 100644
--- a/app/services/lot_service.py
+++ b/app/services/lot_service.py
@@ -22,3 +22,46 @@ def lots_with_status():
         lot["status"] = status_for(lot["capacity"], lot["occupied"])
         lot["available"] = max(lot["capacity"] - lot["occupied"], 0)
     return lots
+
+
+class LotError(Exception):
+    """Raised with a user-facing message when a rule is broken."""
+
+
+def _clean(name, zone, capacity_raw):
+    name = (name or "").strip()
+    zone = (zone or "").strip()
+    if not name or not zone:
+        raise LotError("Name and zone are required.")
+    try:
+        capacity = int(str(capacity_raw).strip())
+    except ValueError:
+        raise LotError("Capacity must be a whole number above 0.")
+    if capacity < 1:
+        raise LotError("Capacity must be a whole number above 0.")
+    return name, zone, capacity
+
+
+def get_lot(lot_id):
+    lot = lot_repository.find_by_id(lot_id)
+    if lot is None:
+        raise LotError("That lot does not exist.")
+    return lot
+
+
+def create_lot(name, zone, capacity_raw):
+    name, zone, capacity = _clean(name, zone, capacity_raw)
+    if lot_repository.find_by_name(name):
+        raise LotError("A lot with that name already exists.")
+    return lot_repository.create(name, zone, capacity)
+
+
+def update_lot(lot_id, name, zone, capacity_raw):
+    lot = get_lot(lot_id)
+    name, zone, capacity = _clean(name, zone, capacity_raw)
+    other = lot_repository.find_by_name(name)
+    if other and other["id"] != lot_id:
+        raise LotError("A lot with that name already exists.")
+    if capacity < lot["occupied"]:
+        raise LotError(f"Capacity can't be lower than the {lot['occupied']} spaces occupied.")
+    lot_repository.update(lot_id, name, zone, capacity)
