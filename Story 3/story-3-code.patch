diff --git a/app/repositories/permit_repository.py b/app/repositories/permit_repository.py
new file mode 100644
index 0000000..8781d24
--- /dev/null
+++ b/app/repositories/permit_repository.py
@@ -0,0 +1,28 @@
+from ..db import get_db
+
+
+def create(vehicle_id, zone):
+    db = get_db()
+    cur = db.execute("INSERT INTO permit (vehicle_id, zone) VALUES (?, ?)", (vehicle_id, zone))
+    db.commit()
+    return cur.lastrowid
+
+
+def find_active(vehicle_id, zone):
+    """A pending or approved permit for this vehicle and zone, if there is one."""
+    row = get_db().execute(
+        "SELECT * FROM permit WHERE vehicle_id = ? AND zone = ? "
+        "AND status IN ('pending', 'approved')",
+        (vehicle_id, zone),
+    ).fetchone()
+    return dict(row) if row else None
+
+
+def list_for_user(user_id):
+    rows = get_db().execute(
+        "SELECT permit.*, vehicle.plate FROM permit "
+        "JOIN vehicle ON vehicle.id = permit.vehicle_id "
+        "WHERE vehicle.user_id = ? ORDER BY permit.id",
+        (user_id,),
+    ).fetchall()
+    return [dict(r) for r in rows]
